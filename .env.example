# Merchant App database connection
DATABASE_URL=postgresql://user:password@host:5432/savour_merchant?sslmode=require

# Public base URL of the Savour Marketplace deployment (no trailing slash required).
MARKETPLACE_API_URL=https://your-marketplace-domain.example

# Must exactly match MERCHANT_APP_INTEGRATION_SECRET in the Marketplace deployment.
# Server-to-server only; generate a random value with at least 32 characters.
MERCHANT_APP_INTEGRATION_SECRET=

# Separate random encryption key used only to encrypt the per-business Marketplace API token at rest.
# Use at least 32 random characters. Do not reuse the pairing secret.
MERCHANT_APP_TOKEN_ENCRYPTION_KEY=

# Optional administrative approval hook used by the Merchant App's existing approval endpoint.
MARKETPLACE_ADMIN_TOKEN=

# Shared rate-limit store (Upstash Redis REST or Vercel KV). Without these the limiter is
# per-instance only and is not coordinated across deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV compatibility: used only when the UPSTASH_* variables above are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Canonical public origin of this deployment, e.g. https://merchant.example.com.
# When set, mutating API requests must send this exact Origin and Host headers are ignored.
APP_ORIGIN=

# Transactional account email via Resend. EMAIL_FROM must be a verified sender address
# (or Resend's shared onboarding@resend.dev test sender). Without both values, account
# emails are skipped instead of blocking registration or password recovery.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: reject unverified accounts from merchant APIs. Keep false until real email
# delivery has been confirmed; reads, logout, password change and resend stay available.
REQUIRE_EMAIL_VERIFICATION=false

# Header your reverse proxy overwrites with the real client IP (e.g. x-real-ip).
# Leave empty on Vercel, which already injects x-vercel-forwarded-for. When neither is
# available in production, all clients share one rate-limit bucket.
TRUSTED_PROXY_IP_HEADER=
