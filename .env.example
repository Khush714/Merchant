# Merchant App database connection
DATABASE_URL=postgresql://user:password@host:5432/savour_merchant?sslmode=require

# Public base URL of the Savour Marketplace deployment (no trailing slash required).
MARKETPLACE_API_URL=https://your-marketplace-domain.example

# Must exactly match MERCHANT_APP_INTEGRATION_SECRET in the Marketplace deployment.
# Server-to-server only; generate a random value with at least 32 characters.
MERCHANT_APP_INTEGRATION_SECRET=

# Separate random encryption key used only to encrypt the per-business Marketplace API token at rest.
# Use at least 32 random characters. Do not reuse the pairing secret.
MERCHANT_APP_TOKEN_ENCRYPTION_KEY=

# Optional administrative approval hook used by the Merchant App's existing approval endpoint.
MARKETPLACE_ADMIN_TOKEN=
